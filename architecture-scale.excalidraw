    {
      "id": "dd1_b",
      "type": "text",
      "x": 920,
      "y": 1876,
      "width": 680.4,
      "height": 112.5,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
