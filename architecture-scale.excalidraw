    {
      "id": "cost_b",
      "type": "text",
      "x": -230,
      "y": 1366,
      "width": 918,
      "height": 135,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
      "containerId": null,
      "fillStyle": "solid",
      "fontFamily": 1,
      "fontSize": 18,
      "frameId": null,
      "groupIds": [],
      "index": "aZ",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "Speech to text: 1.7M h / 100 per GPU x 2 (idle + spare) x $0.80/h x 1.25 region\n    = ~$35k   (same hours on Deepgram Nova-3 at $0.0077/min: ~$790k)\nJev: 620M sentences x 300 tokens x $0.042 per M = ~$8k\nDiagram LLM: 93M calls x ~$0.00019 (1.5k in x $0.05/M + 300 out x $0.38/M, A) = ~$18k\nExport LLM: 2.6M lessons x ~$0.0015 (20k in x $0.05/M + 1.2k out x $0.38/M, A) = ~$4k\nTotal: ~$64k a month = ~$0.025 a lesson = ~$0.04 a lesson-hour",
      "roughness": 1,
      "roundness": null,
      "seed": 38209250,
      "strokeColor": "#1e1e1e",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "Speech to text: 1.7M h / 100 per GPU x 2 (idle + spare) x $0.80/h x 1.25 region\n    = ~$35k   (same hours on Deepgram Nova-3 at $0.0077/min: ~$790k)\nJev: 620M sentences x 300 tokens x $0.042 per M = ~$8k\nDiagram LLM: 93M calls x ~$0.00019 (1.5k in x $0.05/M + 300 out x $0.38/M, A) = ~$18k\nExport LLM: 2.6M lessons x ~$0.0015 (20k in x $0.05/M + 1.2k out x $0.38/M, A) = ~$4k\nTotal: ~$64k a month = ~$0.025 a lesson = ~$0.04 a lesson-hour",
      "textAlign": "left",
      "updated": 1792579135447,
