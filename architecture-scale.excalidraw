      "opacity": 100,
      "originalText": "Wi-Fi drops: one lesson, one GPU",
      "roughness": 1,
      "roundness": null,
      "seed": 1964602062,
      "strokeColor": "#1e1e1e",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "Wi-Fi drops: one lesson, one GPU",
      "textAlign": "left",
      "updated": 1792580422027,
      "version": 1,
      "versionNonce": 1423198230,
      "verticalAlign": "top"
    },
    {
      "id": "dd2_b",
      "type": "text",
      "x": 1660,
      "y": 2256,
      "width": 680.4,
      "height": 112.5,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
      "containerId": null,
      "fillStyle": "solid",
      "fontFamily": 1,
      "fontSize": 18,
      "frameId": null,
      "groupIds": [],
      "index": "b1W",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "A lesson's socket stays on one GPU until it closes.\nEach settled sentence is numbered and saved right away.\nReconnect sends the last number + 10 s of held audio.\nAny GPU in the region can carry on. Lost: one half sentence.\nOur code sets timeout=3600, so 1 h+ lessons may get cut: check.",
      "roughness": 1,
      "roundness": null,
      "seed": 875899822,
      "strokeColor": "#1e1e1e",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "A lesson's socket stays on one GPU until it closes.\nEach settled sentence is numbered and saved right away.\nReconnect sends the last number + 10 s of held audio.\nAny GPU in the region can carry on. Lost: one half sentence.\nOur code sets timeout=3600, so 1 h+ lessons may get cut: check.",
      "textAlign": "left",
      "updated": 1792580422027,
      "version": 1,
      "versionNonce": 1199860810,
      "verticalAlign": "top"
    },
