    {
      "id": "dd1_b",
      "type": "text",
      "x": 920,
      "y": 2256,
      "width": 680.4,
      "height": 112.5,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
      "containerId": null,
      "fillStyle": "solid",
      "fontFamily": 1,
      "fontSize": 18,
      "frameId": null,
      "groupIds": [],
      "index": "b1T",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "After a quiet spell, first teacher waits 65-92 s (warm: 1.1 s).\nTimer warms GPUs 20 min early, sized from last week +30%.\nCap each GPU at its measured load, not the 512 in our code.\nNo GPU free in 2 s: audio goes to Deepgram (~20x dearer).\nLater: Padlet's own always-on GPUs; Modal only for overflow.",
      "roughness": 1,
      "roundness": null,
      "seed": 1564910847,
      "strokeColor": "#1e1e1e",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "After a quiet spell, first teacher waits 65-92 s (warm: 1.1 s).\nTimer warms GPUs 20 min early, sized from last week +30%.\nCap each GPU at its measured load, not the 512 in our code.\nNo GPU free in 2 s: audio goes to Deepgram (~20x dearer).\nLater: Padlet's own always-on GPUs; Modal only for overflow.",
      "textAlign": "left",
      "updated": 1792580422027,
      "version": 1,
      "versionNonce": 1804669654,
      "verticalAlign": "top"
    },
    {
      "id": "dd2",
