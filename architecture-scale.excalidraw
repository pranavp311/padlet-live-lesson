      "index": "ah",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "POST /lessons  {board id}  ->  {lesson id, speech URL, token}\nWS   speech gateway /ws?lesson=..&token=..&from=n\n     in: audio chunks    out: rough text, settled sentences\nLive updates channel (Padlet's own, A)  ->  diagram changes\nPOST /lessons/:id/end  ->  starts the export\nGET  /lessons/:id/export  ->  lesson.json\nProposed, past lessons (teacher's own only):\nGET  /lessons  ->  list     GET /lessons/:id  ->  summary, text, diagrams\nGET  /lessons/:id/export?as=json or txt     DELETE /lessons/:id\nJev: POST api.typesafe.ai/v1/systemone  {last 3 sentences, 3 questions}",
      "roughness": 1,
      "roundness": null,
      "seed": 2046770847,
      "strokeColor": "#1e1e1e",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "POST /lessons  {board id}  ->  {lesson id, speech URL, token}\nWS   speech gateway /ws?lesson=..&token=..&from=n\n     in: audio chunks    out: rough text, settled sentences\nLive updates channel (Padlet's own, A)  ->  diagram changes\nPOST /lessons/:id/end  ->  starts the export\nGET  /lessons/:id/export  ->  lesson.json\nProposed, past lessons (teacher's own only):\nGET  /lessons  ->  list     GET /lessons/:id  ->  summary, text, diagrams\nGET  /lessons/:id/export?as=json or txt     DELETE /lessons/:id\nJev: POST api.typesafe.ai/v1/systemone  {last 3 sentences, 3 questions}",
      "textAlign": "left",
      "updated": 1792580422027,
      "version": 1,
      "versionNonce": 2010251798,
      "verticalAlign": "top"
    },
