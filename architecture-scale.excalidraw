      "groupIds": [],
      "index": "b1W",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "A lesson's socket stays on one GPU until it closes.\nEach settled sentence is numbered and saved right away.\nReconnect sends the last number + 10 s of held audio.\nAny GPU in the region can carry on. Lost: one half sentence.\nOur code sets timeout=3600, so 1 h+ lessons may get cut: check.",
      "roughness": 1,
      "roundness": null,
      "seed": 520600490,
      "strokeColor": "#1e1e1e",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "A lesson's socket stays on one GPU until it closes.\nEach settled sentence is numbered and saved right away.\nReconnect sends the last number + 10 s of held audio.\nAny GPU in the region can carry on. Lost: one half sentence.\nOur code sets timeout=3600, so 1 h+ lessons may get cut: check.",
      "textAlign": "left",
      "updated": 1792579135447,
      "version": 1,
      "versionNonce": 1712100745,
      "verticalAlign": "top"
    },
