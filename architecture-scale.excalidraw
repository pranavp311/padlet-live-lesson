      "groupIds": [],
      "index": "aT",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "Teachers can\n- start a live lesson from Padlet and see their words within 0.5 s\n- watch diagrams draw as they explain: flow, cycle, timeline, graph, molecule\n- lose Wi-Fi for a moment and carry on without losing the lesson\n- end the lesson and send it to Boards, Arcade or Sandbox\n\nOut of scope\n- students joining the live view; languages besides English\n\nLimits\n- 8 am rush: thousands of lessons start within minutes\n- keeps working when our GPUs are full (backup speech to text)\n- class audio is never stored; schools own the text (COPPA, FERPA)\n- well under $1 per lesson-hour",
      "roughness": 1,
      "roundness": null,
      "seed": 477715396,
      "strokeColor": "#1e1e1e",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "Teachers can\n- start a live lesson from Padlet and see their words within 0.5 s\n- watch diagrams draw as they explain: flow, cycle, timeline, graph, molecule\n- lose Wi-Fi for a moment and carry on without losing the lesson\n- end the lesson and send it to Boards, Arcade or Sandbox\n\nOut of scope\n- students joining the live view; languages besides English\n\nLimits\n- 8 am rush: thousands of lessons start within minutes\n- keeps working when our GPUs are full (backup speech to text)\n- class audio is never stored; schools own the text (COPPA, FERPA)\n- well under $1 per lesson-hour",
      "textAlign": "left",
      "updated": 1792579135447,
      "version": 1,
      "versionNonce": 1860033415,
      "verticalAlign": "top"
    },
