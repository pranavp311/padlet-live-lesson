      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "WS  /ws (Modal)\n    in: audio chunks   out: rough text, settled sentence\nPOST /warm (Modal) -> starts the GPU early\nPOST /api/clean  {sentence, last 3} -> {tidy text}\nPOST /api/diagram  {recent sentences, current diagram}\n    -> {action, changes}\nPOST /api/export  {sentences, diagrams} -> lesson.json\nPOST api.typesafe.ai/v1/systemone (Jev)\n    {last 3 sentences, 3 questions} -> probabilities\nDownloads (in the browser, no server)\n    lesson.json, transcript .txt, each diagram as SVG/PNG",
      "roughness": 1,
      "roundness": null,
      "seed": 576257012,
      "strokeColor": "#1e1e1e",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "WS  /ws (Modal)\n    in: audio chunks   out: rough text, settled sentence\nPOST /warm (Modal) -> starts the GPU early\nPOST /api/clean  {sentence, last 3} -> {tidy text}\nPOST /api/diagram  {recent sentences, current diagram}\n    -> {action, changes}\nPOST /api/export  {sentences, diagrams} -> lesson.json\nPOST api.typesafe.ai/v1/systemone (Jev)\n    {last 3 sentences, 3 questions} -> probabilities\nDownloads (in the browser, no server)\n    lesson.json, transcript .txt, each diagram as SVG/PNG",
      "textAlign": "left",
